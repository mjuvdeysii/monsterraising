<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">
<LinearLayout
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/w_img"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="12dp"
        android:padding="2dp"
        android:src="@drawable/mascot_s1"
        android:scaleType="fitCenter"
        android:background="@drawable/widget_icon_bg"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/w_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/w_ink"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/w_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/w_ink2"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
    <TextView
        android:id="@+id/w_jr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/w_ink2"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/w_btns"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/wb_nurse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/wb_nurse">
            <ImageView
                android:id="@+id/wi_nurse"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/w_nurse"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/wt_nurse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="亲喂"
                android:textColor="@color/w_ink"
                android:textSize="13sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wb_bottle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/wb_bottle">
            <ImageView
                android:id="@+id/wi_bottle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/w_bottle"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/wt_bottle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="瓶喂"
                android:textColor="@color/w_ink"
                android:textSize="13sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wb_sleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/wb_sleep">
            <ImageView
                android:id="@+id/wi_sleep"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/w_sleep"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/wt_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="睡眠"
                android:textColor="@color/w_ink"
                android:textSize="13sp"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wb_diaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/wb_diaper">
            <ImageView
                android:id="@+id/wi_diaper"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/w_diaper"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/wt_diaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="尿布"
                android:textColor="@color/w_ink"
                android:textSize="13sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
